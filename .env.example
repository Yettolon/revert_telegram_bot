BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=revert_bot
DB_USER=bot_user
DB_PASSWORD=your_secure_password_here

# Revert Finance API
REVERT_API_URL=https://api.revert.finance

# Scheduler Settings
UPDATE_INTERVAL=300
NOTIFICATION_CHECK_INTERVAL=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application
DEBUG=False

DEBANK_PROFILE_URL = https://debank.com/profile/

# Redis
REDIS_URL = "redis://redis:6379/0"